 19, "font": "EB Garamond", "align": "center", "runs": [["VI \u00b7 ", "v red"], ["Regulation", "v"], ["", "br"], ["returns to set point", "i"]], "color": "#e8d5a3"}, {"id": "cap6", "x": 504.5, "y": 726, "w": 216, "size": 14.5, "lh": 19, "font": "EB Garamond", "align": "center", "runs": [["VII \u00b7 ", "v red"], ["Revision", "v"], ["", "br"], ["returns displaced", "i"]], "color": "#e8d5a3"}, {"id": "cap7", "x": 729.5, "y": 726, "w": 216, "size": 14.5, "lh": 19, "font": "EB Garamond", "align": "center", "runs": [["VIII \u00b7 ", "v red"], ["Additive change", "v"], ["", "br"], ["new branch, old kept", "i"]], "color": "#e8d5a3"}, {"id": "cap8", "x": 54.5, "y": 996, "w": 216, "size": 14.5, "lh": 19, "font": "EB Garamond", "align": "center", "runs": [["IX \u00b7 ", "v red"], ["Substitutive change", "v"], ["", "br"], ["old route struck out", "i"]], "color": "#e8d5a3"}, {"id": "cap9", "x": 279.5, "y": 996, "w": 216, "size": 14.5, "lh": 19, "font": "EB Garamond", "align": "center", "runs": [["X \u00b7 ", "v red"], ["Generative substrate", "v"], ["", "br"], ["conditions beneath", "i"]], "color": "#e8d5a3"}, {"id": "cap10", "x": 504.5, "y": 996, "w": 216, "size": 14.5, "lh": 19, "font": "EB Garamond", "align": "center", "runs": [["XI \u00b7 ", "v red"], ["Reflexive loop", "v"], ["", "br"], ["the map moves it", "i"]], "color": "#e8d5a3"}, {"id": "cap11", "x": 729.5, "y": 996, "w": 216, "size": 14.5, "lh": 19, "font": "EB Garamond", "align": "center", "runs": [["XII \u00b7 ", "v red"], ["Learned invariant", "v"], ["", "br"], ["hard walls, one door", "i"]], "color": "#e8d5a3"}, {"id": "fc_c", "x": 540, "y": 1120, "w": 404, "size": 18.5, "font": "IM FELL English", "color": "#e8d5a3", "ls": 0.01, "runs": [["At the narrow turn, loosen the fingers. Too much meal will join the ends. Too little will persuade the next hand that the line was meant to break there.", ""], ["", "br"], ["Make it again beside the first. Do not sweep the first away until the difference has been seen.", ""]], "lh": 25.5, "para_gap": 9}, {"id": "fc_u", "x": 560, "y": 1392, "w": 380, "size": 25, "font": "Zeyada", "color": "#9d927c", "runs": [["I swept it away because we needed the table.", ""]], "lh": 27.5, "para_gap": 4}, {"id": "folio", "x": 844, "y": 1540, "w": 100, "size": 13, "lh": 18, "font": "EB Garamond", "align": "right", "color": "#9d927c", "ls": 0.12, "runs": [["xiii", "v"]]}], "verso_boxes": [{"id": "rh_l", "x": 56, "y": 24, "w": 420, "size": 14, "font": "EB Garamond", "runs": [["Clavicula Matricis", "v"]], "color": "#1c1813", "lh": 18}, {"id": "rh_r", "x": 524, "y": 24, "w": 420, "size": 14, "font": "EB Garamond", "align": "right", "color": "#a3271b", "runs": [["Verso \u00b7 Tabula XIII", "v"]], "lh": 18}, {"id": "sketch", "x": 150, "y": 120, "w": 700, "size": 19.5, "lh": 28, "font": "EB Garamond", "color": "#1c1813", "para_gap": 10, "runs": [["Sketching.", "v red"], [" Any sketch made with the practice follows one rule: a sketch prompts a claim and never replaces one. Revision 3\u2019s twelve sketching marks remain available, provided each mark\u2019s meaning is stated every time it is used.", ""]]}, {"id": "mark", "x": 150, "y": 254.08, "w": 700, "size": 19.5, "lh": 28, "font": "EB Garamond", "color": "#1c1813", "para_gap": 10, "runs": [["The mark.", "v red"], [" A loose curl with no central dot, turning outward with space between turns, its outer end left open, and a short branch curving away into its own open end. It suggests returning to a question from a changed position, with room to diverge or stop. Rotation and proportion carry no doctrine; Le Guin\u2019s Kesh suggested the orientation, and this is not a Kesh glyph.", ""]]}, {"id": "orient", "x": 150, "y": 458.88, "w": 700, "size": 19.5, "lh": 28, "font": "EB Garamond", "para_gap": 5, "runs": [["Orientation.", "v red"], ["", "br"], ["\u00b7 ", "red"], ["Keep models contestable.", ""], ["", "br"], ["\u00b7 ", "red"], ["Make purposes and exclusions visible.", ""], ["", "br"], ["\u00b7 ", "red"], ["Protect reporting and the capacity to act on it.", ""], ["", "br"], ["\u00b7 ", "red"], ["Know who controls what fades, and who else can read the clock.", ""], ["", "br"], ["\u00b7 ", "red"], ["Count the costs of action and of inaction.", ""], ["", "br"], ["\u00b7 ", "red"], ["Keep care independent of earned worth.", ""], ["", "br"], ["\u00b7 ", "red"], ["Let the practice itself be revised or abandoned. No one needs permission to stop using it, and no service may depend on adherence.", ""]], "color": "#1c1813"}, {"id": "orient_c", "x": 170, "y": 790.32, "w": 680, "size": 20, "font": "IM FELL English", "color": "#1c1813", "ls": 0.01, "runs": [["This sentence was omitted from the small copies for want of room.", ""]], "lh": 27.6, "para_gap": 10}, {"id": "xii", "x": 150, "y": 917.2320000000001, "w": 700, "size": 17, "lh": 22, "font": "EB Garamond", "color": "#6d5f4b", "runs": [["XII \u00b7 ", "v red"], ["Learned invariant", "v"], [" \u2014 hard walls, one door", "i"]]}, {"id": "s06", "x": 150, "y": 949.2320000000001, "w": 700, "size": 26, "font": "Sue Ellen Francisco", "color": "#a3271b", "runs": [["An invariant is sometimes a discovery and sometimes a prohibition wearing its mask.", ""]], "lh": 29.1, "para_gap": 4}, {"id": "s15", "x": 190, "y": 1380, "w": 640, "size": 30, "font": "Zeyada", "color": "#4a463f", "runs": [["There was no mark for a keeper who wished to stop.", ""]], "lh": 33.0, "para_gap": 4}], "key_boxes": [{"id": "ks_h", "x": 60, "y": 60, "w": 880, "size": 15, "lh": 20, "font": "EB Garamond", "color": "#a3271b", "runs": [["Proof slip \u00b7 the legacy hand", "v"]]}, {"id": "ks_n", "x": 60, "y": 86, "w": 880, "size": 14.5, "lh": 20, "font": "EB Garamond", "color": "#6d5f4b", "runs": [["One table drew every inscription in this hand: the twelve rings and the great seal of XIII, the margins of VIII, the frame of III. It has no digits or punctuation, so ring I carries its caption without \u2018(P5)\u2019.", "i"]]}, {"id": "ks_a", "x": 60.0, "y": 206, "w": 67.6923