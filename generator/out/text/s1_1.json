[{"id": "rh_l", "x": 56, "y": 28, "w": 420, "size": 13, "lh": 17, "font": "IM FELL English SC", "ls": 0.22, "color": "#1c1813", "runs": [["Clavicula Matricis", ""]]}, {"id": "rh_r", "x": 476, "y": 28, "w": 468, "size": 13, "lh": 17, "font": "IM FELL English SC", "ls": 0.22, "align": "right", "color": "#a3271b", "runs": [["§ 1 · Purpose, scope and starting points", ""]]}, {"id": "secno", "x": 300, "y": 112, "w": 400, "size": 16, "lh": 20, "font": "IM FELL English SC", "ls": 0.3, "align": "center", "color": "#a3271b", "runs": [["§ 1", ""]]}, {"id": "sectitle", "x": 80, "y": 138, "w": 840, "size": 34, "lh": 40, "font": "IM FELL English", "align": "center", "color": "#1c1813", "runs": [["Purpose, scope and starting points", ""]]}, {"id": "flow0", "x": 128, "y": 252, "w": 624, "size": 19, "lh": 27.4, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 11, "runs": [["The practice asks one question of any system: can it still discover that it is wrong, and act on that, as its power grows? It applies to systems that combine people, institutions, technologies and habitats. It is a set of questions and proposals, not a discipline or a decision engine.", ""], ["", "br"], ["Scope, declared before testing.", "sc red"], [" A practice that explains away every null result cannot be tested, so the expected results come first.", ""]]}, {"id": "s1_t0_0", "x": 108, "y": 469.924, "w": 224.0, "size": 13.5, "lh": 18, "font": "IM FELL DW Pica SC", "sc_font": "IM FELL DW Pica SC", "color": "#a3271b", "para_gap": 0, "runs": [["Setting", ""]]}, {"id": "s1_t0_1", "x": 348.0, "y": 469.924, "w": 224.0, "size": 13.5, "lh": 18, "font": "IM FELL DW Pica SC", "sc_font": "IM FELL DW Pica SC", "color": "#a3271b", "para_gap": 0, "runs": [["Expected contribution", ""]]}, {"id": "s1_t0_2", "x": 588.0, "y": 469.924, "w": 304.0, "size": 13.5, "lh": 18, "font": "IM FELL DW Pica SC", "sc_font": "IM FELL DW Pica SC", "color": "#a3271b", "para_gap": 0, "runs": [["Why", ""]]}, {"id": "s1_t1_0", "x": 108, "y": 505.00399999999996, "w": 224.0, "size": 15, "lh": 20, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Mature network and hosting reliability reviews", "i"]]}, {"id": "s1_t1_1", "x": 348.0, "y": 505.00399999999996, "w": 224.0, "size": 15, "lh": 20, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Little or none beyond a competent review", ""]]}, {"id": "s1_t1_2", "x": 588.0, "y": 505.00399999999996, "w": 304.0, "size": 15, "lh": 20, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Established practice already covers dependencies, recovery testing and blameless reporting", ""]]}, {"id": "s1_t2_0", "x": 108, "y": 563.404, "w": 224.0, "size": 15, "lh": 20, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Agentic AI systems", "i"]]}, {"id": "s1_t2_1", "x": 348.0, "y": 563.404, "w": 224.0, "size": 15, "lh": 20, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Supported findings a generic checklist misses", ""]]}, {"id": "s1_t2_2", "x": 588.0, "y": 563.404, "w": 304.0, "size": 15, "lh": 20, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Fast deployment, few upstream owners, gameable measures, affected third parties with no say", ""]]}, {"id": "s1_t3_0", "x": 108, "y": 621.804, "w": 224.0, "size": 15, "lh": 20, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Leaderless or adversarial coordination", "i"]]}, {"id": "s1_t3_1", "x": 348.0, "y": 621.804, "w": 224.0, "size": 15, "lh": 20, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Supported findings a generic checklist misses", ""]]}, {"id": "s1_t3_2", "x": 588.0, "y": 621.804, "w": 304.0, "size": 15, "lh": 20, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Visibility, timing and record-keeping carry risks that ordinary reviews ignore", ""]]}, {"id": "s1_t4_0", "x": 108, "y": 680.204, "w": 224.0, "size": 15, "lh": 20, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Institutions whose corrective authority is itself implicated", "i"]]}, {"id": "s1_t4_1", "x": 348.0, "y": 680.204, "w": 224.0, "size": 15, "lh": 20, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Diagnosis only", ""]]}, {"id": "s1_t4_2", "x": 588.0, "y": 680.204, "w": 304.0, "size": 15, "lh": 20, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["The remedies assume someone accountable can act (§12)", ""]]}, {"id": "flow2", "x": 128, "y": 756.6, "w": 624, "size": 19, "lh": 27.4, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 11, "runs": [["A null result in the first row is a passed prediction. A null result in the second or third row counts against the practice.", ""], ["", "br"], ["Starting points.", "sc red"], [" Four are descriptive claims:", ""], ["", "br"], ["¶ ", "red"], ["P1.", "sc red"], [" Accounts of complex systems are situated and incomplete.", ""], ["", "br"], ["¶ ", "red"], ["P2.", "sc red"], [" Updating inside a model does not show that the model is adequate.", ""], ["", "br"], ["¶ ", "red"], ["P3.", "sc red"], [" Representations can change what they represent.", ""], ["", "br"], ["¶ ", "red"], ["P4.", "sc red"], [" Lives depend on material, social and ecological conditions, some of them hard to rebuild.", ""], ["", "br"], ["Four are adopted commitments, not findings:", ""], ["", "br"], ["¶ ", "red"], ["P5.", "sc red"], [" Moral consideration follows welfare, with precaution where sentience is credibly uncertain.", ""], ["", "br"], ["¶ ", "red"], ["P6.", "sc red"], [" Care is not earned by contribution. Arbitrary power and permanent outgroups are opposed.", ""], ["", "br"], ["¶ ", "red"], ["P7.", "sc red"], [" Flourishing is plural; no single quantity is maximized.", ""], ["", "br"], ["¶ ", "red"], ["P8.", "sc red"], [" Greater consequential power should not erode the capacity to discover and act on inadequacy.", ""], ["", "br"], ["One is a procedural wager:", ""], ["", "br"], ["¶ ", "red"], ["P9.", "sc red"], [" Use accountable review, staged change and tested successors rather than an unrevisable final judge. This manages fallibility; it does not prove the procedure right.", ""]]}, {"id": "gl_9_1", "x": 790, "y": 1064.004, "w": 160, "size": 12.5, "lh": 15.5, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#6d5f4b", "align": "center", "para_gap": 0, "runs": [["X · ", "sc red"], ["generative substrate", "sc"], ["", "br"], ["conditions beneath", "i"]]}, {"id": "gl_0_2", "x": 790, "y": 1214.004, "w": 160, "size": 12.5, "lh": 15.5, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#6d5f4b", "align": "center", "para_gap": 0, "runs": [["I · ", "sc red"], ["interest-bearing being", "sc"], ["", "br"], ["has standing (P5)", "i"]]}, {"id": "folio", "x": 420, "y": 1548, "w": 160, "size": 12, "lh": 16, "font": "IM FELL English SC", "ls": 0.2, "align": "center", "color": "#6d5f4b", "runs": [["1 · 1", ""]]}]