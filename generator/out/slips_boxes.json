BM Plex Mono", "ls": 0.06, "color": "#1c1813", "runs": [["introduced", ""]]}, {"id": "h_f1", "x": 290, "y": 337, "w": 194, "size": 13, "lh": 18, "font": "IBM Plex Mono", "ls": 0.06, "color": "#1c1813", "runs": [["registered", ""]]}, {"id": "h_f2", "x": 504, "y": 337, "w": 194, "size": 13, "lh": 18, "font": "IBM Plex Mono", "ls": 0.06, "color": "#1c1813", "runs": [["withdrawn", ""]]}], "i_boxes": [{"id": "i_base", "x": 128, "y": 64, "w": 800, "size": 22, "font": "IM FELL DW Pica", "color": "#1c1813", "ls": 0.01, "runs": [["The first contradiction is entered beside the seal. The seal is not scraped away; neither is the contradiction.", ""], ["", "br"], ["The next keeper receives both.", ""]], "lh": 30.4, "para_gap": 11}, {"id": "i_u", "x": 640, "y": 322, "w": 300, "size": 28, "font": "Zeyada", "color": "#4a463f", "runs": [["I received the seal. The objection was on a separate slip.", ""]], "lh": 30.8, "para_gap": 4}]}