[{"id": "rh_l", "x": 60, "y": 40, "w": 480, "size": 17, "lh": 22, "font": "IM FELL English SC", "ls": 0.2, "color": "#1c1813", "runs": [["Clavicula Matricis", ""]]}, {"id": "rh_r", "x": 520, "y": 40, "w": 620, "size": 17, "lh": 22, "font": "IM FELL English SC", "ls": 0.16, "align": "right", "color": "#a3271b", "runs": [["§ 2 · The core practice", ""]]}, {"id": "secno", "x": 400, "y": 146, "w": 400, "size": 22, "lh": 26, "font": "IM FELL English SC", "ls": 0.3, "align": "center", "color": "#a3271b", "runs": [["§ 2", ""]]}, {"id": "sectitle", "x": 70, "y": 180, "w": 1060, "size": 46, "lh": 54, "font": "IM FELL English", "align": "center", "color": "#1c1813", "runs": [["The core practice", ""]]}, {"id": "flow0", "x": 118, "y": 330, "w": 764, "size": 28, "lh": 39.5, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 15, "runs": [["Three questions organize the work, three rules govern change, and every measure is checked for feedback.", ""], ["", "br"], ["Three questions.", "sc red"], [" They overlap with double-loop learning and are practical distinctions, not levels of mind.", ""], ["", "br"], ["¶ ", "red"], ["Inference:", "sc red"], [" what follows inside the present model?", ""], ["", "br"], ["¶ ", "red"], ["Criticism:", "sc red"], [" does the model or strategy fit the problem?", ""], ["", "br"], ["¶ ", "red"], ["Constitution:", "sc red"], [" are the goals, categories, standards or participants themselves wrong?", ""], ["", "br"], ["Regulation and revision.", "sc red"], [" Holding an agreed condition and revising the purpose need different procedures and different speeds. Declare the regulated variable, its bounds, who benefits, who bears its costs and who can change it. A technically effective regulator can enforce an objectionable goal.", ""], ["", "br"], ["Change.", "sc red"], [" Anyone may explore alternatives. Replacing an operating rule needs a stated inadequacy: an anomaly, an exclusion, a contradiction, a near miss, or a credible foreseeable failure.", ""], ["", "br"], ["¶ ", "red"], ["Add before you remove.", "sc red"], [" Prefer changes that add a usable option. Check later whether the option became compulsory through network effects, withdrawn services or cost.", ""], ["", "br"], ["¶ ", "red"], ["Test the successor first.", "sc red"], [" Test it at a fitting scale, record what would count as its failure, and keep the old rule’s protective functions. Stage changes; declare coupled changes as one revision.", ""]]}, {"id": "gl_5_0", "x": 906, "y": 833.0, "w": 234, "size": 16.5, "lh": 20.5, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#6d5f4b", "align": "center", "para_gap": 0, "runs": [["VI · ", "sc red"], ["regulation", "sc"], ["", "br"], ["returns to set point", "i"]]}, {"id": "gl_6_1", "x": 906, "y": 1009.0, "w": 234, "size": 16.5, "lh": 20.5, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#6d5f4b", "align": "center", "para_gap": 0, "runs": [["VII · ", "sc red"], ["revision", "sc"], ["", "br"], ["returns displaced", "i"]]}, {"id": "gl_7_2", "x": 906, "y": 1185.0, "w": 234, "size": 16.5, "lh": 20.5, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#6d5f4b", "align": "center", "para_gap": 0, "runs": [["VIII · ", "sc red"], ["additive change", "sc"], ["", "br"], ["new branch, old kept", "i"]]}, {"id": "gl_8_3", "x": 906, "y": 1361.0, "w": 234, "size": 16.5, "lh": 20.5, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#6d5f4b", "align": "center", "para_gap": 0, "runs": [["IX · ", "sc red"], ["substitutive change", "sc"], ["", "br"], ["old route struck out", "i"]]}, {"id": "folio", "x": 500, "y": 1530, "w": 200, "size": 16, "lh": 20, "font": "IM FELL English SC", "ls": 0.2, "align": "center", "color": "#6d5f4b", "runs": [["2 · 1", ""]]}]