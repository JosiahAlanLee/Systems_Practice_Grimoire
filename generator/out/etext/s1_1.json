[{"id": "rh_l", "x": 60, "y": 40, "w": 480, "size": 17, "lh": 22, "font": "IM FELL English SC", "ls": 0.2, "color": "#1c1813", "runs": [["Clavicula Matricis", ""]]}, {"id": "rh_r", "x": 520, "y": 40, "w": 620, "size": 17, "lh": 22, "font": "IM FELL English SC", "ls": 0.16, "align": "right", "color": "#a3271b", "runs": [["§ 1 · Purpose, scope and starting points", ""]]}, {"id": "secno", "x": 400, "y": 146, "w": 400, "size": 22, "lh": 26, "font": "IM FELL English SC", "ls": 0.3, "align": "center", "color": "#a3271b", "runs": [["§ 1", ""]]}, {"id": "sectitle", "x": 70, "y": 180, "w": 1060, "size": 46, "lh": 54, "font": "IM FELL English", "align": "center", "color": "#1c1813", "runs": [["Purpose, scope and starting points", ""]]}, {"id": "flow0", "x": 118, "y": 330, "w": 764, "size": 28, "lh": 39.5, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 15, "runs": [["The practice asks one question of any system: can it still discover that it is wrong, and act on that, as its power grows? It applies to systems that combine people, institutions, technologies and habitats. It is a set of questions and proposals, not a discipline or a decision engine.", ""], ["", "br"], ["Scope, declared before testing.", "sc red"], [" A practice that explains away every null result cannot be tested, so the expected results come first.", ""]]}, {"id": "s1_t0_0", "x": 80, "y": 623.26, "w": 257.20000000000005, "size": 19, "lh": 24, "font": "IM FELL DW Pica SC", "sc_font": "IM FELL DW Pica SC", "color": "#a3271b", "para_gap": 0, "runs": [["Setting", ""]]}, {"id": "s1_t0_1", "x": 357.20000000000005, "y": 623.26, "w": 277.0, "size": 19, "lh": 24, "font": "IM FELL DW Pica SC", "sc_font": "IM FELL DW Pica SC", "color": "#a3271b", "para_gap": 0, "runs": [["Expected contribution", ""]]}, {"id": "s1_t0_2", "x": 654.2, "y": 623.26, "w": 395.79999999999995, "size": 19, "lh": 24, "font": "IM FELL DW Pica SC", "sc_font": "IM FELL DW Pica SC", "color": "#a3271b", "para_gap": 0, "runs": [["Why", ""]]}, {"id": "s1_t1_0", "x": 80, "y": 667.38, "w": 257.20000000000005, "size": 21, "lh": 27, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Mature network and hosting reliability reviews", "i"]]}, {"id": "s1_t1_1", "x": 357.20000000000005, "y": 667.38, "w": 277.0, "size": 21, "lh": 27, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Little or none beyond a competent review", ""]]}, {"id": "s1_t1_2", "x": 654.2, "y": 667.38, "w": 395.79999999999995, "size": 21, "lh": 27, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Established practice already covers dependencies, recovery testing and blameless reporting", ""]]}, {"id": "s1_t2_0", "x": 80, "y": 768.785, "w": 257.20000000000005, "size": 21, "lh": 27, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Agentic AI systems", "i"]]}, {"id": "s1_t2_1", "x": 357.20000000000005, "y": 768.785, "w": 277.0, "size": 21, "lh": 27, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Supported findings a generic checklist misses", ""]]}, {"id": "s1_t2_2", "x": 654.2, "y": 768.785, "w": 395.79999999999995, "size": 21, "lh": 27, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Fast deployment, few upstream owners, gameable measures, affected third parties with no say", ""]]}, {"id": "s1_t3_0", "x": 80, "y": 870.1899999999999, "w": 257.20000000000005, "size": 21, "lh": 27, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Leaderless or adversarial coordination", "i"]]}, {"id": "s1_t3_1", "x": 357.20000000000005, "y": 870.1899999999999, "w": 277.0, "size": 21, "lh": 27, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Supported findings a generic checklist misses", ""]]}, {"id": "s1_t3_2", "x": 654.2, "y": 870.1899999999999, "w": 395.79999999999995, "size": 21, "lh": 27, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Visibility, timing and record-keeping carry risks that ordinary reviews ignore", ""]]}, {"id": "s1_t4_0", "x": 80, "y": 944.4599999999999, "w": 257.20000000000005, "size": 21, "lh": 27, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Institutions whose corrective authority is itself implicated", "i"]]}, {"id": "s1_t4_1", "x": 357.20000000000005, "y": 944.4599999999999, "w": 277.0, "size": 21, "lh": 27, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["Diagnosis only", ""]]}, {"id": "s1_t4_2", "x": 654.2, "y": 944.4599999999999, "w": 395.79999999999995, "size": 21, "lh": 27, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 0, "runs": [["The remedies assume someone accountable can act (§12)", ""]]}, {"id": "flow2", "x": 118, "y": 1042.7, "w": 764, "size": 28, "lh": 39.5, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#1c1813", "para_gap": 15, "runs": [["A null result in the first row is a passed prediction. A null result in the second or third row counts against the practice.", ""], ["", "br"], ["Starting points.", "sc red"], [" Four are descriptive claims:", ""], ["", "br"], ["¶ ", "red"], ["P1.", "sc red"], [" Accounts of complex systems are situated and incomplete.", ""], ["", "br"], ["¶ ", "red"], ["P2.", "sc red"], [" Updating inside a model does not show that the model is adequate.", ""], ["", "br"], ["¶ ", "red"], ["P3.", "sc red"], [" Representations can change what they represent.", ""], ["", "br"], ["¶ ", "red"], ["P4.", "sc red"], [" Lives depend on material, social and ecological conditions, some of them hard to rebuild.", ""]]}, {"id": "gl_9_0", "x": 906, "y": 1432, "w": 234, "size": 16.5, "lh": 20.5, "font": "IM FELL DW Pica", "sc_font": "IM FELL DW Pica SC", "color": "#6d5f4b", "align": "center", "para_gap": 0, "runs": [["X · ", "sc red"], ["generative substrate", "sc"], ["", "br"], ["conditions beneath", "i"]]}, {"id": "folio", "x": 500, "y": 1530, "w": 200, "size": 16, "lh": 20, "font": "IM FELL English SC", "ls": 0.2, "align": "center", "color": "#6d5f4b", "runs": [["1 · 1", ""]]}]